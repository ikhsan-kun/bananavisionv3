# BananaVision Python FastAPI — Environment Variables
# Copy ke .env dan sesuaikan

# Tipe model default saat startup (mobilenetv2 atau resnet50)
MODEL_TYPE=mobilenetv2

# Path absolut folder model .keras
# Development: kosongkan (default ke folder python/)
# Server production: /opt/bananavision/models
MODEL_DIR=/opt/bananavision/models

# URL Node.js backend untuk auto-recovery model saat startup
# Development: http://localhost:5000/api
# Server (keduanya di mesin sama): http://localhost:5000/api
NODE_BACKEND_URL=http://localhost:5000/api
